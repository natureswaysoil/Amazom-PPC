# ============================================================================
# Amazon PPC Optimizer - Environment Variables Example
# ============================================================================
# This file shows examples of all supported environment variables.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env file to git (it's in .gitignore)!

# ============================================================================
# AMAZON ADVERTISING API CREDENTIALS
# ============================================================================
# Get these from Amazon Advertising API Console: https://advertising.amazon.com/API/
AMAZON_CLIENT_ID=amzn1.application-oa2-client.YOUR_CLIENT_ID_HERE
AMAZON_CLIENT_SECRET=amzn1.oa2-cs.v1.YOUR_CLIENT_SECRET_HERE
AMAZON_REFRESH_TOKEN=Atzr|IwEBIYOUR_REFRESH_TOKEN_HERE
AMAZON_PROFILE_ID=1780498399290938

# ============================================================================
# GOOGLE CLOUD PLATFORM CREDENTIALS
# ============================================================================
# Choose ONE of the following methods to provide GCP credentials:

# --- METHOD 1: Raw JSON (Recommended for CI/CD) ---
# Copy the entire contents of your service account key file
# Example format (all on one line, no line breaks):
# GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project","private_key_id":"abc123...","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n","client_email":"service-account@project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/service-account%40project.iam.gserviceaccount.com"}'

# To set this variable:
# 1. Download service account key from Google Cloud Console (IAM & Admin > Service Accounts)
# 2. Copy the entire JSON file contents
# 3. Set as environment variable (remove line breaks in the JSON):
#    export GCP_SERVICE_ACCOUNT_KEY='<paste entire JSON here>'
# 4. Or store in GitHub Secrets / Vercel Environment Variables as-is
GCP_SERVICE_ACCOUNT_KEY=

# --- METHOD 2: Base64-Encoded JSON (For environments with special character issues) ---
# Some platforms have issues with newlines or quotes in environment variables.
# Base64 encoding solves this problem.
#
# To create base64-encoded credentials:
#   cat service-account.json | base64 | tr -d '\n' > service-account-b64.txt
#   export GCP_SERVICE_ACCOUNT_KEY="$(cat service-account-b64.txt)"
#
# Example (base64 string, no line breaks):
# GCP_SERVICE_ACCOUNT_KEY=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6InlvdXItcHJvamVjdCIsInByaXZhdGVfa2V5X2lkIjoiYWJjMTIzLi4uIiwicHJpdmF0ZV9rZXkiOiItLS0tLUJFR0lOIFBSSVZBVEUgS0VZLS0tLS1cbk1JSUU...
#
# The application automatically detects and decodes base64-encoded credentials.

# --- METHOD 3: File Path (Local Development Only) ---
# Point to a service account JSON key file on your local filesystem
# Note: This ONLY works locally, not in Cloud Functions or serverless environments
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# --- METHOD 4: Individual Components (Advanced/Alternative) ---
# You can also provide credentials as separate environment variables
# This is less common but supported for specific deployment scenarios
# GCP_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# GCP_PROJECT=your-project-id
# Note: When using GCP_PRIVATE_KEY, preserve \n for newlines in the private key

# ============================================================================
# GOOGLE CLOUD PROJECT CONFIGURATION
# ============================================================================
# Your Google Cloud Project ID
GCP_PROJECT=your-project-id
GOOGLE_CLOUD_PROJECT=your-project-id

# BigQuery configuration
BIGQUERY_PROJECT_ID=your-project-id
BIGQUERY_DATASET_ID=amazon_ppc
BIGQUERY_LOCATION=us-east4

# ============================================================================
# DASHBOARD CONFIGURATION (Optional)
# ============================================================================
DASHBOARD_URL=https://your-dashboard.vercel.app
DASHBOARD_API_KEY=your_dashboard_api_key_here
DASHBOARD_ENABLED=true
DASHBOARD_SEND_REAL_TIME_UPDATES=true

# ============================================================================
# OPTIMIZER CONFIGURATION
# ============================================================================
# Configuration file path (optional - overrides config.json)
# PPC_CONFIG_PATH=./sample_config.yaml

# Or provide full config as JSON string (optional)
# PPC_CONFIG='{"amazon_api": {...}, "bid_optimization": {...}}'

# ============================================================================
# RUNTIME FLAGS
# ============================================================================
# Dry run mode (true = no changes made, false = make actual changes)
PPC_DRY_RUN=true

# Specific features to run (comma-separated)
# Available: bid_optimization, dayparting, campaign_management, keyword_discovery, negative_keywords, budget_optimization, placement_bids
# PPC_FEATURES=bid_optimization,dayparting

# Connection verification settings
PPC_VERIFY_CONNECTION=false
PPC_VERIFY_SAMPLE_SIZE=5

# ============================================================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com
TO_EMAIL=alerts@example.com

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_OUTPUT_DIR=./logs

# ============================================================================
# DEVELOPMENT/TESTING FLAGS
# ============================================================================
# Set to 'true' to enable debug mode
DEBUG=false

# Set to 'true' to skip actual API calls (for testing)
MOCK_API_CALLS=false

# ============================================================================
# IMPORTANT NOTES & BEST PRACTICES
# ============================================================================
#
# 1. GETTING STARTED:
#    - Copy this file: cp .env.example .env
#    - Fill in your credentials in .env
#    - Load variables: export $(cat .env | xargs)
#    - Or use python-dotenv: pip install python-dotenv
#
# 2. SECURITY:
#    ✅ DO use Google Secret Manager for production credentials
#    ✅ DO rotate service account keys regularly (every 90 days)
#    ✅ DO use separate service accounts for dev/staging/prod
#    ✅ DO grant minimum required permissions (BigQuery Data Editor, Job User)
#    ❌ DON'T commit .env file to git (it's in .gitignore)
#    ❌ DON'T share credentials in plain text via email/chat
#    ❌ DON'T use personal account credentials for production
#
# 3. SERVICE ACCOUNT PERMISSIONS:
#    Your GCP service account needs these roles:
#    - BigQuery Data Editor (roles/bigquery.dataEditor)
#    - BigQuery Job User (roles/bigquery.jobUser)
#
#    To grant permissions:
#    gcloud projects add-iam-policy-binding your-project-id \
#      --member="serviceAccount:your-sa@your-project.iam.gserviceaccount.com" \
#      --role="roles/bigquery.dataEditor"
#    gcloud projects add-iam-policy-binding your-project-id \
#      --member="serviceAccount:your-sa@your-project.iam.gserviceaccount.com" \
#      --role="roles/bigquery.jobUser"
#
# 4. CREATING SERVICE ACCOUNT KEY:
#    a. Go to Google Cloud Console: https://console.cloud.google.com
#    b. Navigate to: IAM & Admin → Service Accounts
#    c. Select your service account (or create new)
#    d. Go to Keys tab → Add Key → Create new key
#    e. Choose JSON format and download
#    f. Use the downloaded JSON with one of the methods above
#
# 5. TESTING CREDENTIALS:
#    # Validate credentials locally:
#    python -c "from gcp_credentials import validate_credentials_early; print(validate_credentials_early())"
#
#    # Test via health check endpoint:
#    curl "https://your-function-url?health=true"
#
# 6. TROUBLESHOOTING:
#    - If you see "GCP_SERVICE_ACCOUNT_KEY is not valid JSON":
#      * Verify you copied the entire JSON file contents
#      * Check for no extra spaces or line breaks
#      * Test JSON validity: echo "$GCP_SERVICE_ACCOUNT_KEY" | jq .
#
#    - If you see "missing required service account fields":
#      * Download a fresh service account key from Google Cloud Console
#      * Don't modify or edit the JSON file
#
#    - If you see "Could not load the default credentials":
#      * Ensure GCP_SERVICE_ACCOUNT_KEY is set correctly
#      * Verify service account has required permissions
#      * Check that the service account is enabled
#
#    For more help, see README.md section on GCP credentials
#
# ============================================================================
