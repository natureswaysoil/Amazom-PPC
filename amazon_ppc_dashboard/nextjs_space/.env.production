# ==============================================================================
# Amazon PPC Dashboard - Production Environment Configuration
# ==============================================================================
# This file contains production environment variables for the Next.js dashboard
# deployed to Cloud Run. These values are used when the dashboard connects to
# BigQuery to retrieve and display data.
#
# IMPORTANT: In Cloud Run, these are set via environment variables during
# deployment. This file serves as documentation and a reference.
# ==============================================================================

# Google Cloud Project Configuration
NEXT_PUBLIC_GCP_PROJECT=amazon-ppc-474902
GCP_PROJECT=amazon-ppc-474902
GOOGLE_CLOUD_PROJECT=amazon-ppc-474902

# BigQuery Configuration
NEXT_PUBLIC_BIGQUERY_DATASET=amazon_ppc_data
BIGQUERY_DATASET=amazon_ppc_data
BQ_DATASET_ID=amazon_ppc_data

NEXT_PUBLIC_BIGQUERY_LOCATION=us-east4
BIGQUERY_LOCATION=us-east4
BQ_LOCATION=us-east4

# API URL (set during deployment)
# NEXT_PUBLIC_API_URL=https://ppc-dashboard-nextjs-1009540130231.us-central1.run.app

# Dashboard API Key (from Secret Manager)
# DASHBOARD_API_KEY is loaded from Google Secret Manager secret 'dashboard-api-key'
# Do not hardcode the value here

# ==============================================================================
# Notes:
# ==============================================================================
# 1. In Cloud Run, credentials are handled via Application Default Credentials
#    (the service account attached to the Cloud Run service)
#
# 2. The dashboard deployment script sets these environment variables during
#    deployment: ./dashboard/deploy-dashboard-to-cloudrun.sh
#
# 3. NEXT_PUBLIC_* variables are exposed to the browser and should NOT contain
#    sensitive data
#
# 4. BigQuery permissions required for the Cloud Run service account:
#    - roles/bigquery.dataViewer
#    - roles/bigquery.jobUser
# ==============================================================================
