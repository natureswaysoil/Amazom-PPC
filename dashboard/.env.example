# Dashboard Environment Variables

# Google Cloud Configuration
GCP_PROJECT_ID=nature-way-soils
BIGQUERY_DATASET=amazon_ppc

# Credentials (choose one method)
# Method 1: Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Method 2: JSON string (for Secret Manager)
# GCP_CREDENTIALS_JSON={"type": "service_account", "project_id": "..."}

# Method 3: Base64 encoded JSON (for Secret Manager)
# GCP_CREDENTIALS_BASE64=base64-encoded-json-here

# Server Configuration
PORT=8080
